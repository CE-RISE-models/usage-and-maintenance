            owl:onProperty uq:correlation_basis_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty uq:second_quantity_reference_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty uq:first_quantity_reference_value ],
        [ a owl:Restriction ;
