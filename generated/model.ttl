uq:Correlation a owl:Class ;
    rdfs:label "Correlation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty uq:correlation_basis_value ],
        [ a owl:Restriction ;
