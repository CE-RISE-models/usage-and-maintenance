    rdfs:label "budget_method_value" ;
    rdfs:range uam:PropagationMethodEnum ;
    skos:definition "Method used to combine uncertainty components" ;
    skos:inScheme uq: ;
    uam:owl.filler "uq:budgetMethodValue" ;
