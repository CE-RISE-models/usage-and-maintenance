            owl:onProperty mt:reference_valid_until_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mt:traceability_quantity_kind_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mt:reference_valid_from_value ],
        [ a owl:Restriction ;
