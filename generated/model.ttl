<https://ce-rise-models.codeberg.page/usage-and-maintenance/.owl.ttl> a owl:Ontology ;
    rdfs:label "usage-and-maintenance" ;
    dcterms:license "CC BY-NC 4.0" ;
    dcterms:title "CE-RISE Usage and Maintenance Data Model" ;
    pav:version "0.1.1" ;
    skos:definition """Data model for capturing product operation, usage patterns, maintenance activities, and related instructions throughout the product lifecycle.
""" .

uam:UsageAndMaintenance a owl:Class ;
